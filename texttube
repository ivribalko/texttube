#!/bin/bash

# Launch TextTube from a repository checkout by reusing the repo-local .venv
# and routing local commands into the checkout runtime only.

# Fail on unset variables, nonzero commands, and broken pipelines.
set -euo pipefail

# Resolve the checkout root and the local virtualenv locations.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${TEXTTUBE_REPO_ROOT:-${SCRIPT_DIR}}"
PYTHON_BIN="${TEXTTUBE_PYTHON_BIN:-python3}"
VENV_DIR="${REPO_ROOT}/.venv"
REQUIREMENTS_FILE="${REPO_ROOT}/requirements.txt"
OLLAMA_PORT=11434

show_help() {
  cat <<'EOF'
Usage:
  ./texttube [run] [--limit N | --video URL_OR_ID] [--cache] [--verbose] [--reset-cutoff]
  ./texttube init
  ./texttube auth
  ./texttube --help

Commands:
  run      Run once. This is the default command.
  init     Create or update checkout .secrets interactively.
  auth     Renew the YouTube OAuth refresh token in .secrets.

Options:
  --limit N          Maximum videos to process. Default is 100; use 0 for unlimited.
  --video URL_OR_ID  Summarize one video instead of subscription uploads.
  --cache            Reuse and update per-video transcript and audio caches.
  --verbose          Print detailed progress logs instead of stage-start logs only.
  --reset-cutoff     Manual runs only. Ignore the saved subscription cutoff for this run.
  -h, --help         Show this help.
EOF
}

authenticate_youtube() {
  local repo
  repo="${REPO_ROOT}"
  if [[ ! -f "${repo}/.secrets" ]]; then
    echo "Missing ${repo}/.secrets; create it before running auth." >&2
    exit 1
  fi

  TEXTTUBE_SECRETS_PATH="${repo}/.secrets" "${PYTHON_BIN}" "${repo}/texttube_auth.py"
}

initialize_checkout() {
  "${PYTHON_BIN}" "${REPO_ROOT}/texttube_init.py" --mode checkout --home "${REPO_ROOT}"
}

ollama_is_ready() {
  "${PYTHON_BIN}" - <<'PY' >/dev/null 2>&1
import sys
from urllib import error, request

try:
    with request.urlopen("http://127.0.0.1:11434/api/version", timeout=1) as response:
        sys.exit(0 if response.status == 200 else 1)
except (OSError, error.URLError):
    sys.exit(1)
PY
}

setup_venv() {
  if [[ ! -x "${VENV_DIR}/bin/python" ]]; then
    # Create the repo-local venv the first time the checkout is used.
    "${PYTHON_BIN}" -m venv "${VENV_DIR}"
    # Keep routine pip stdout quiet while leaving errors visible on stderr.
    "${VENV_DIR}/bin/python" -m pip install --upgrade pip >/dev/null
  fi

  # Keep routine pip stdout quiet while leaving errors visible on stderr.
  "${VENV_DIR}/bin/pip" install --requirement "${REQUIREMENTS_FILE}" >/dev/null
}

# Ensure the local runtime directories exist before launching the app.
mkdir -p "${REPO_ROOT}/var/logs" "${REPO_ROOT}/var"

if [[ $# -eq 0 ]]; then
  set -- run
else
  case "${1}" in
    -h|--help)
      show_help
      exit 0
      ;;
    run|init|auth)
      ;;
    *)
      set -- run "$@"
      ;;
  esac
fi

case "${1}" in
  run)
    shift
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      show_help
      exit 0
    fi
    set -- run "$@"
    ;;
  init)
    shift
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      show_help
      exit 0
    fi
    if [[ $# -ne 0 ]]; then
      echo "Usage: ./texttube init" >&2
      exit 2
    fi
    initialize_checkout
    exit 0
    ;;
  auth)
    shift
    if [[ $# -ne 0 ]]; then
      echo "Usage: ./texttube auth" >&2
      exit 2
    fi
    authenticate_youtube
    exit 0
    ;;
esac

# Set up the local virtualenv before launching the app.
setup_venv

if ! ollama_is_ready; then
  echo "Ollama is not reachable on port ${OLLAMA_PORT}; start it separately before running checkout TextTube." >&2
  exit 1
fi

if [[ "${1}" == "run" ]]; then
  shift
  cd "${REPO_ROOT}"
  exec env TEXTTUBE_MANUAL_RUN=1 "${VENV_DIR}/bin/python" "${REPO_ROOT}/texttube_app.py" "$@"
fi
